APP_MODE=local
DATABASE_URL=sqlite:///./portal.db
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:5173
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

